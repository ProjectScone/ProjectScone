# Reviewed environment inventory. No credentials belong in this template.
# Copy/edit as .env.local (0600); existing local settings must not be overwritten.
# Python entrypoints read exported environment, not this file automatically.
# Validate private file format without launching: ./scripts/serve-self-hosted.sh --check
# Explicit launch: ./scripts/serve-self-hosted.sh

# === Python memory HTTP / CLI / MCP: Settings.from_env ===
# Template defaults use local SQLite and deterministic hash embeddings.
# The private .env.local may instead mirror the existing working local profile.
SCONE_DOCUMENTS=sqlite
SCONE_VECTORS=sqlite
SCONE_EMBEDDER=hash
SCONE_SQLITE_PATH='~/.scone-memory/memory.db'
# SCONE_BLOB_DIR='~/.scone-memory/blobs'
# Attachment storage: auto preserves file/SQLite defaults; memory is ephemeral.
SCONE_BLOBS=auto
# Optional AWS attachment storage (install scone-memory[aws]). Set all three
# resource settings only with SCONE_BLOBS=s3. Documents/vectors are independent.
# SCONE_S3_BUCKET=
# SCONE_DYNAMODB_BLOB_TABLE=
# SCONE_AWS_REGION=us-east-1
# SCONE_S3_PREFIX=attachments/
# Terraform resource inputs (scripts/terraform_env.py --check):
# SCONE_AWS_ACCOUNT_ID=
# SCONE_AWS_NAME_PREFIX=
# SCONE_AWS_TAGS='{}'
# Credentials use the AWS SDK chain; prefer a workload IAM role. Never put
# credentials in this template. Terraform inputs come from the environment;
# private .env files, populated variable files, plans, and state stay ignored.


# HTTP bind and authentication. No bearer is generated by the server.
# Set one existing private key, or key:space[:role] pairs in SCONE_API_KEYS.
# SCONE_API_KEY alone authorizes the space named default.
SCONE_HOST=127.0.0.1
SCONE_PORT=7437
SCONE_API_KEY=
SCONE_API_KEYS=
SCONE_INGEST_CONCURRENCY=4

# Optional named agents, model choices and encrypted workflow state.
# Private owned 0600 JSON; see packages/memory/docs/agent-models.md.
# Keep the encryption key named by its key_env outside this file and source control.
# SCONE_AGENTS_CONFIG=/absolute/path/to/agents.json

# Optional encrypted local background document imports. Private owned 0600 JSON.
# See packages/memory/docs/file-ingestion.md; no automatic replay after restart.
# SCONE_DOCUMENT_JOBS_CONFIG=/absolute/path/to/document-jobs.json
# Fetching a page by URL (POST /v1/documents/from-url, `scone import-url`) is off
# unless asked for; private, loopback and link-local hosts stay refused unless the
# second flag is set too.
# SCONE_URL_IMPORT=0
# SCONE_URL_IMPORT_PRIVATE=0

# Optional trusted local directory collections and encrypted sync runs.
# Private owned 0600 JSON; see packages/memory/docs/directory-sync-runs.md.
# SCONE_DIRECTORY_SYNC_CONFIG=/absolute/path/to/directory-sync.json

# Optional local timestamped transcription, with an explicitly selected model.
# Private owned 0600 JSON; see packages/memory/docs/media-document-ingestion.md.
# SCONE_DOCUMENT_MEDIA_CONFIG=/absolute/path/to/document-media.json

# Optional visible-text video OCR using explicitly configured local executables.
# Private owned 0600 JSON; see packages/memory/docs/video-frame-ocr.md.
# SCONE_DOCUMENT_VIDEO_CONFIG=/absolute/path/to/document-video.json

# Optional PDF OCR for document imports; off unless an executable is selected.
# Install the pdf-ocr extra, Tesseract and selected language data separately.
# See packages/memory/docs/file-ingestion.md. No downloads occur at startup.
# SCONE_DOCUMENT_OCR_EXECUTABLE=/absolute/path/to/tesseract
# SCONE_DOCUMENT_OCR_LANGUAGE=eng
# Languages a request may choose in pdf_ocr.language, besides the one above.
# SCONE_DOCUMENT_OCR_LANGUAGES=deu,jpn+eng
# SCONE_DOCUMENT_OCR_PSM=3
# SCONE_DOCUMENT_OCR_DPI=150
# Turn a page Tesseract's orientation detection is sure is upside down or on its
# side before reading it (needs Tesseract's osd language data). Off by default.
# SCONE_DOCUMENT_OCR_ORIENTATION=1
# A layout engine that labels each page region (title, heading, list, table, footnote...):
# an executable that reads a page PNG on stdin and answers in JSON lines (docs/pdf-ocr.md). Unset,
# regions are labelled from the page's own geometry only.
# SCONE_DOCUMENT_LAYOUT_EXECUTABLE=/absolute/path/to/layout-engine

# Retrieval and evidence logging.
SCONE_CONTEXTUAL_EMBEDDINGS=0
# The headings above a chunk (or, for code, its file and declarations) in its
# embedding input; see packages/memory/docs/retrieval-and-storage.md.
# Changes vector writer identity and requires rebuilding existing vectors.
SCONE_HEADING_CONTEXT=0
# Shorten that context (and table headers) so each input fits the embedder's
# declared window; the chunk itself is never cut. Needs an embedder that
# declares its window (the local BGE models do). Changes vector writer identity.
SCONE_EMBEDDING_BUDGET=0
# Measure the length chunker's target in tokens instead of 700 characters: whole
# sentences are packed up to it, and one is cut inside only when it alone is longer
# (the receipt counts it). Counted by the embedder's tokenizer when it has one, by a
# no-model estimate otherwise; code, structure, semantic and unit cuts keep characters.
# Changes which chunks new records get; stored chunks are never recut.
# See packages/memory/docs/retrieval-and-storage.md.
# SCONE_CHUNK_TOKENS=512
# Tokens of the chunk before that each such chunk starts with (default 0).
# SCONE_CHUNK_OVERLAP_TOKENS=0
# A second pass over semantic cuts (a record's chunking=semantic): neighbouring chunks
# at least this alike (cosine of their sentences' mean vectors, above 0 and at most 1)
# are joined again when they fit the chunk target together. The receipt counts merges
# and whether similarity or size stopped each one. The scale is the embedder's, so a
# value measured with one embedder does not carry to another: with the hash embedder
# on LongMemEval-S (n=50) 0.2 removed 2.4% of semantic chunks and moved no recall score.
# Unset: no second pass, unless a record names its own semantic_merge_threshold. Changes
# which chunks new records get; stored chunks are never recut. See
# packages/memory/docs/retrieval-and-storage.md.
# SCONE_SEMANTIC_MERGE_THRESHOLD=0.2
# Source-declared table headers in embedding inputs; see packages/memory/docs/table-context-embeddings.md.
# Changes vector writer identity and requires rebuilding existing vectors.
SCONE_TABLE_CONTEXT_EMBEDDINGS=0
# Reuse vectors for chunk text already embedded; see packages/memory/docs/file-ingestion.md.
# Unset or none: no cache. memory: this process only. A file path: shared by every process
# that opens it, so a later sync re-embeds only chunks whose text changed.
# SCONE_EMBEDDING_CACHE=~/.scone/embeddings.sqlite
SCONE_DEMOTE_RESTATED=0
# A file of synonym groups for the text lane, one group per line, terms separated by
# commas ("car, automobile"); a query term in a group adds the group's other members
# to the text lane's query only, and every recall records what it added.
# SCONE_SYNONYMS=./synonyms.txt
# Index what each chunk is under (headings, title, source name) beside its text and
# search it as a lane of its own, fused by rank at twice the weight of the other lanes
# (measured; see the docs). Stored text never changes; SQLite and in-memory stores keep it.
SCONE_CONTEXT_LANE=0
# Search the questions each chunk answers beside its context. The questions are written by
# hand with the chat model (scone chunk-questions, POST /v1/chunk-questions), kept only with
# a sentence quoted from the chunk, and indexed apart from the context lane's words; recall
# returns the chunk's own text. Off by default; the pass refuses to run while it is off.
SCONE_QUESTION_LANE=0
# The text lane searches a query term's family by stem prefix (bill* for billing, billed,
# bills); the index is untouched and every recall lists the prefixes it added. On by default,
# measured; set 0 to turn it off.
SCONE_LEXICAL_STEMS=1
# With stem prefixes on, a passage holding the query's own word ("billing") has its family
# weighed at that word's idf rather than the family's; one holding only a relative ("bills")
# scores as before, and the family is still one term. On by default, measured; set 0 to turn
# it off. Every recall says whether it was on (prefixes.exact_forms); it takes effect only
# where the store took the prefixes (prefixes.applied).
SCONE_LEXICAL_EXACT_FORMS=1
# The vector lane's voice in rank fusion against the text lane's 1.0. Unset, a hashed-token
# embedder gets 0.01 (a weak echo of the text lane: every voice it had in the order cost the
# ranking, measured on LongMemEval-S) and any other embedder 1.0; 0.25 was the hashed default
# before. Every recall event records the weights.
# SCONE_VECTOR_WEIGHT=1.0
# Predicates whose values hold side by side, named one by one. Any predicate
# not named here holds one value at a time, as the ledger always has.
# SCONE_MANY_VALUED=knows,owns
# What this space's predicates mean to each other, so that the graph can
# work out what follows from a claim. Configured, never guessed; what
# follows is kept apart from what was said, and says what it rests on.
# SCONE_RELATION_INVERSE=works_at:employs,wrote:written_by
# SCONE_RELATION_SYMMETRIC=married_to,colleague_of
# SCONE_RELATION_TRANSITIVE=part_of,located_in
# A floor to abstain by, measured with this embedder by `scone calibrate`.
# Without one, nothing is withheld for looking unlikely.
# SCONE_ABSTENTION_POLICY=./abstention.json
# Which claims make a profile; unset means all of them.
# SCONE_PROFILE_PREDICATES=prefers,uses,works_at
# SCONE_PROFILE_WITHOUT=met
# SCONE_SIMILARITY_FLOOR=0.3
# How much newer memory is favoured in fusion: the recency term's size at age zero
# (default 0.005, a near-tie breaker; 0 turns it off) and the days until it halves (default 30).
# SCONE_RECENCY_WEIGHT=0.005
# SCONE_RECENCY_HALF_LIFE_DAYS=30
# How much recorded feedback (useful / not useful judgements) moves a passage in fusion:
# 0, the default, reads none. Refused with SCONE_EVENTS=none. Only a passage's newest two judgements each way
# count, and the term is cut at 0.000529 either way (first place over second under rank fusion,
# both lanes at full voice).
# SCONE_FEEDBACK_WEIGHT=0
# Optional candidate-depth override and trusted operator-provided reranker.
# Empty candidates preserves existing retrieval depth; no provider means off.
# SCONE_RECALL_CANDIDATES=100
SCONE_RERANKER_FACTORY=
# Alternatively select a preprovisioned CPU cross encoder. Both values are
# required, mutually exclusive with SCONE_RERANKER_FACTORY. No model downloads.
SCONE_RERANKER_CROSS_ENCODER_DIR=
SCONE_RERANKER_CROSS_ENCODER_MODEL=
# Optional tuning requires the directory/model pair above.
# SCONE_RERANKER_CROSS_ENCODER_MAX_PAIR_TOKENS=512
# SCONE_RERANKER_CROSS_ENCODER_THREADS=2
# SCONE_RERANKER_CROSS_ENCODER_BATCH_SIZE=8
# Pair tokens 2..8192, threads 1..16, batch size 1..128; install offline-rerank extra.
# Alternatively the chat model (SCONE_CHAT_URL, SCONE_CHAT_MODEL) orders the candidates
# listwise, a window at a time, with a receipt of its calls; exclusive with the two above.
# Passages per call 2..20 (default 20), step 1..window-1 (default half the window),
# bytes per passage 64..8192 (default 1024), seconds for the whole pass >0..600
# (default 60; SCONE_RERANK_TIMEOUT does not apply to it). A reply that is not a
# ranking keeps that window's order and says so; a timeout keeps fused order.
# It is for recall calls that can wait: conversation turns (text and voice) do
# not run it and keep fused order, and the recalls of one parts or follow-up
# request share one timeout between their passes.
# Setting the chat model for it also starts the distiller.
# SCONE_RERANKER_LISTWISE=1
# SCONE_RERANKER_LISTWISE_WINDOW=20
# SCONE_RERANKER_LISTWISE_STEP=10
# SCONE_RERANKER_LISTWISE_PASSAGE_BYTES=1024
# SCONE_RERANKER_LISTWISE_TIMEOUT=60
# SCONE_RERANK_LIMIT=32
# SCONE_RERANK_MAX_BYTES=64000
# SCONE_RERANK_TIMEOUT=1.0
# Bounds: candidates 1..1000, rerank limit 1..128, bytes 512..256000,
# timeout >0..10 seconds. Factory must be a trusted synchronous module:factory
# returning an object with async rerank(query, candidates); no provider default.
SCONE_EVENTS=sqlite
SCONE_EVENTS_QUERIES=hash
SCONE_EVENTS_MAX=10000
# SCONE_EVENTS_MAX_AGE_DAYS=90
# Explicit episode expiry policy; leave empty to retain indefinitely.
SCONE_RETAIN=
# Example only: SCONE_RETAIN='conversation=90,observation=30'
# SCONE_LOG_PATH='~/.scone-memory/runtime.log'

# Existing local model connections: a private JSON file, not provider credentials.
# SCONE_MODEL_CONNECTIONS='~/.scone-memory/model-connections.json'
# SCONE_CONVERSATIONS_JOURNAL='~/.scone-memory/conversations.db'
# Optional trusted Python module:callable; defining a string does not install it.
# SCONE_CONVERSATIONS_MODEL_FACTORY=
# Persona JSON and trusted ProviderRegistry factory must be configured together.
# SCONE_CONVERSATIONS_PERSONAS=
# SCONE_CONVERSATIONS_REGISTRY=

# Opt-in memory tools for text using the saved self-hosted chat connection.
# native requires OpenAI-compatible tool calls; structured requires JSON schema.
# Requires MODEL_CONNECTIONS + CONVERSATIONS_JOURNAL. Voice stays unchanged.
# Cannot combine with adaptive retrieval or custom factories/catalogs.
SCONE_CONVERSATIONS_TOOL_MODE=off
# Enabled tool mode searches the final user message before model inference.
SCONE_CONVERSATIONS_TOOL_INITIAL_SEARCH=1
# Optional exact calculation over retrieved source quotes (requires tool mode).
SCONE_CONVERSATIONS_TOOL_COMPUTE=0
# Optional exact answers from a document's table cells in tool mode (requires tool mode).
SCONE_CONVERSATIONS_TOOL_TABLES=0
# SCONE_CONVERSATIONS_TOOL_MAX_CALLS=4
# SCONE_CONVERSATIONS_TOOL_MAX_ROUNDS=4
# SCONE_CONVERSATIONS_TOOL_TIMEOUT=120

# Opt-in text answer review on the composed conversation server.
# report can retain an uncertain draft; require_supported withholds it.
# Review checks memory-backed turns, not greetings without prepared evidence.
# Endpoint/model are separate from chat/extraction; credentials are never inherited.
SCONE_ANSWER_REVIEW_POLICY=off
# SCONE_ANSWER_REVIEW_URL=http://127.0.0.1:11434/v1
# SCONE_ANSWER_REVIEW_MODEL=YOUR_INSTALLED_MODEL
SCONE_ANSWER_REVIEW_API_KEY=
# SCONE_ANSWER_REVIEW_TIMEOUT=20
# text (copied quotes) or spans (host-owned draft excerpts)
SCONE_ANSWER_REVIEW_QUOTE_MODE=text

# Opt-in adaptive retrieval before text generation; never borrows another key.
# Requires SCONE_CONVERSATIONS_JOURNAL and an explicitly provisioned assessor.
SCONE_ADAPTIVE_RETRIEVAL=0
# SCONE_ADAPTIVE_URL=http://127.0.0.1:11434/v1
# SCONE_ADAPTIVE_MODEL=YOUR_INSTALLED_MODEL
SCONE_ADAPTIVE_API_KEY=
# Whole adaptive retrieval budget; the existing full-turn timeout still applies.
# SCONE_ADAPTIVE_TIMEOUT=15
# SCONE_ADAPTIVE_MAX_ROUNDS=3
# SCONE_ADAPTIVE_MAX_QUERIES=6
# SCONE_ADAPTIVE_CANDIDATE_LIMIT=20
# SCONE_ADAPTIVE_MAX_EVIDENCE_BYTES=16000
# 0 disables pre-assessment graph expansion; 1..6 enables bounded hops.
# SCONE_ADAPTIVE_GRAPH_HOPS=0
# Opt-in attempted-query history for the assessor; requires adaptive retrieval.
# SCONE_ADAPTIVE_SEARCH_HISTORY=0

# Opt-in follow-up queries for served text conversations ("since when?" after
# "Where does Alice Chen work?"). carry searches the earlier user turn's named
# terms beside the message, no model; rewrite asks a self-hosted model to restate
# it and falls back to carry. Requires SCONE_CONVERSATIONS_JOURNAL; not combined
# with adaptive retrieval or tool mode. Its own endpoint; never borrows a key.
# Read by `scone serve` and by `scone serve-conversations --model-factory`, which
# refuses it when history-only; voice sessions search the question alone.
SCONE_FOLLOWUP_QUERIES=off
# SCONE_FOLLOWUP_URL=http://127.0.0.1:11434/v1
# SCONE_FOLLOWUP_MODEL=YOUR_INSTALLED_MODEL
SCONE_FOLLOWUP_API_KEY=
# SCONE_FOLLOWUP_TIMEOUT=5

# Opt-in semantic end of turn for served voice sessions. A final transcript that
# stops mid-clause ("book a table for", an open quote, "um") is held 1.5 s past
# the recognizer's own pause for the rest of the sentence. If speech starts again
# while it is held, the wait runs until the next transcript, up to 10 s after the
# held turn's first transcript, and noise that never yields a transcript waits
# the 10 s. The served HTTP recognizers treat an empty transcription (a cough)
# as an error: the session ends and a held turn is stored, not answered.
# Anything else is answered at the pause as before. Deterministic rules, no
# model. Each user turn records why it ended (metadata turn_end).
SCONE_SEMANTIC_TURN=0

# Opt-in keypad for served voice sessions: off, append or collect. The client
# sends {"type": "keypad", "key": "5"} on the audio socket (a dial pad); off,
# the socket refuses it. append gives each key to the user's turn at once and
# the turn is answered; collect holds keys until #, 3 s without a key or 32
# keys, then gives the turn one entry ("[keypad] 1234#"). Each keyed turn
# records its keys, why the entry ended, and when each key came.
SCONE_VOICE_KEYPAD=off

# Optional local OpenAI-compatible inference; unset means no default distiller.
# The same model serves SCONE_RERANKER_LISTWISE when that is on.
# These generic chat/embedding settings can accept public URLs in the base
# engine. Keep them local; no hosted endpoint is supplied here.
SCONE_CHAT_URL=
SCONE_CHAT_MODEL=
SCONE_CHAT_API_KEY=
# SCONE_CHAT_THINK=false
SCONE_CHAT_TIMEOUT=180
SCONE_DISTILL_INTERVAL_S=30
SCONE_DISTILL_BATCH=20
# Unset: proposed for review. Setting a threshold can approve extractions.
# SCONE_DISTILL_ACCEPT_AT=0.95
SCONE_DERIVE=0

# Embedding options: hash, local (cached FastEmbed), remote (your local service).
# Changing the embedder/model for an existing index requires compatible vectors.
# SCONE_EMBED_MODEL=bge-small-en-v1.5
# SCONE_EMBED_URL=http://127.0.0.1:11434/v1
SCONE_EMBED_API_KEY=
# SCONE_EMBED_CACHE='~/.cache/fastembed'
# Disable native ONNX telemetry before any host/plugin imports its runtime.
ORT_DISABLE_TELEMETRY=1

# === Optional self-hosted document/vector/event stores; all inactive ===
# Select with SCONE_DOCUMENTS / SCONE_VECTORS / SCONE_EVENTS only after setup.
# Mongo: document and event store.
# SCONE_MONGO_URL=mongodb://127.0.0.1:27017
# SCONE_MONGO_DB=scone
# PostgreSQL: document/event stores; pgvector required for vector store.
# SCONE_POSTGRES_URL=
# SCONE_POSTGRES_SCHEMA=scone
# Qdrant vector store.
# SCONE_QDRANT_URL=http://127.0.0.1:6333
# SCONE_QDRANT_API_KEY=
# SCONE_QDRANT_COLLECTION=scone_chunks
# Optional exact metadata fields to index for filtered retrieval.
# SCONE_QDRANT_METADATA_INDEXES=source_type,document_id,language
# Optional positive search beam width; unset preserves server defaults.
# SCONE_QDRANT_HNSW_EF=
# Chroma: choose a persistent directory OR a server.
# SCONE_CHROMA_PATH='~/.scone-memory/chroma'
# SCONE_CHROMA_URL=http://127.0.0.1:8000
# LanceDB local vector directory.
# SCONE_LANCEDB_PATH='~/.scone-memory/lancedb'
# Redis requires the search module.
# SCONE_REDIS_URL=redis://127.0.0.1:6379/0
# SCONE_REDIS_PREFIX=scone_chunks
# Milvus Lite file or self-hosted Milvus server.
# SCONE_MILVUS_URI='~/.scone-memory/milvus.db'
# SCONE_MILVUS_TOKEN=
# SCONE_MILVUS_COLLECTION=scone_chunks
# Elasticsearch: document, vector and event stores.
# SCONE_ELASTICSEARCH_URL=http://127.0.0.1:9200
# SCONE_ELASTICSEARCH_API_KEY=
# SCONE_ELASTICSEARCH_PREFIX=scone

# Native OpenSearch vectors: SCONE_VECTORS=opensearch; install [opensearch].
# Requires a Lucene HNSW cosine-capable OpenSearch 2.4+ endpoint.
# SCONE_OPENSEARCH_URL=http://127.0.0.1:9200
# SCONE_OPENSEARCH_INDEX=scone_vectors
# Optional basic auth; configure both fields or leave both unset.
# SCONE_OPENSEARCH_USERNAME=
# SCONE_OPENSEARCH_PASSWORD=
# SCONE_OPENSEARCH_BATCH_SIZE=256
# SCONE_OPENSEARCH_MAX_BATCH_BYTES=5242880
# SCONE_OPENSEARCH_TIMEOUT=30

# === Optional AWS adapters; endpoints and credentials remain unset ===
# No cloud connection is enabled by this file. Explicit configuration required.
# OpenSearch managed domains: use an HTTPS SCONE_OPENSEARCH_URL.
# IAM auth replaces basic auth; supply region + access key + secret together.
# Session token is optional. No credential discovery, IMDS, or auto-refresh.
# The vector adapter targets managed domains, not OpenSearch Serverless.
# SCONE_OPENSEARCH_AWS_REGION=
# SCONE_OPENSEARCH_AWS_ACCESS_KEY_ID=
# SCONE_OPENSEARCH_AWS_SECRET_ACCESS_KEY=
# SCONE_OPENSEARCH_AWS_SESSION_TOKEN=
# ElastiCache Valkey 8.2+ node-based vector search; SCONE_VECTORS=elasticache.
# Install [elasticache]. Use explicit rediss:// endpoint and ACL credentials.
# Local redis:// is allowed only for loopback contract/service testing.
# SCONE_ELASTICACHE_URL=
# SCONE_ELASTICACHE_PREFIX=scone_vectors
# SCONE_ELASTICACHE_USERNAME=
# SCONE_ELASTICACHE_PASSWORD=
# SCONE_ELASTICACHE_CLUSTER_MODE=1
# FLAT is exact search; HNSW is the explicit approximate alternative.
# SCONE_ELASTICACHE_ALGORITHM=FLAT
# SCONE_ELASTICACHE_BATCH_SIZE=64
# SCONE_ELASTICACHE_TIMEOUT=30
# Optional path to an explicitly provisioned TLS CA bundle.
# SCONE_ELASTICACHE_CA_CERTS=

# === Python MCP stdio server ===
# Uses the same selected stores. --space is a CLI argument, not an env switch.
# Unset keeps native submitted-fact behavior; a threshold parks low confidence.
# SCONE_MCP_PROPOSE_BELOW=0.9

# === External-agent observation hook (only runs when a host invokes it) ===
# This does not install a Codex/Claude hook or start an agent orchestrator.
SCONE_HOOK_AGENT=codex
SCONE_HOOK_SERVER=http://127.0.0.1:7437
SCONE_HOOK_KEY_ENV=SCONE_API_KEY
SCONE_HOOK_FEED=metadata
SCONE_HOOK_CAPTURE=0
SCONE_HOOK_COMPILE=0
SCONE_HOOK_DEBUG=0
# Empty allowlist makes the direct Python hook send nothing.
SCONE_HOOK_PROJECTS=
# Comma-separated session IDs, only when intentionally restricting capture.
SCONE_HOOK_SESSIONS=
# scripts/observe-agent.cjs uses live-connection.json and injects its own
# SCONE_CAPTURE_KEY, feed and compile flags. Do not duplicate its secret here.

# === Optional framework/library privacy controls (not Scone settings) ===
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
OPENAI_AGENTS_DISABLE_TRACING=true
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ANONYMIZED_TELEMETRY=false

# === Constructor/config-file features, not fixed environment variables ===
# Local STT, TTS and vision are selected in the model-connections JSON/UI.
# Optional API tokens use the exact variable name chosen in api_key_env there.
# Cartesia/ElevenLabs/OpenAI transcription adapters require explicit Python
# provider factories. There is no automatic provider selection from this file.
# LangChain/LlamaIndex/OpenAI Agents adapters use explicit Python composition.

# === Not implemented as environment switches; no invented credentials ===
# Agent orchestration, external MCP-client discovery, connector scheduling and
# graph-agent execution are not enabled by this file. Pinecone is not connected.
