# Reviewed environment inventory. No credentials belong in this template.
# Copy/edit as .env.local (0600); existing local settings must not be overwritten.
# Python entrypoints read exported environment, not this file automatically.
# Validate private file format without launching: ./scripts/serve-self-hosted.sh --check
# Explicit launch: ./scripts/serve-self-hosted.sh

# === Python memory HTTP / CLI / MCP: Settings.from_env ===
# Template defaults use local SQLite and deterministic hash embeddings.
# The private .env.local may instead mirror the existing working local profile.
SCONE_DOCUMENTS=sqlite
SCONE_VECTORS=sqlite
SCONE_EMBEDDER=hash
SCONE_SQLITE_PATH='~/.scone-memory/memory.db'
# SCONE_BLOB_DIR='~/.scone-memory/blobs'
# Attachment storage: auto preserves file/SQLite defaults; memory is ephemeral.
SCONE_BLOBS=auto
# Optional AWS attachment storage (install scone-memory[aws]). Set all three
# resource settings only with SCONE_BLOBS=s3. Documents/vectors are independent.
# SCONE_S3_BUCKET=
# SCONE_DYNAMODB_BLOB_TABLE=
# SCONE_AWS_REGION=us-east-1
# SCONE_S3_PREFIX=attachments/
# Terraform resource inputs (scripts/terraform_env.py --check):
# SCONE_AWS_ACCOUNT_ID=
# SCONE_AWS_NAME_PREFIX=
# SCONE_AWS_TAGS='{}'
# Credentials use the AWS SDK chain; prefer a workload IAM role. Never put
# credentials in this template. Terraform inputs come from the environment;
# private .env files, populated variable files, plans, and state stay ignored.


# HTTP bind and authentication. No bearer is generated by the server.
# Set one existing private key, or key:space[:role] pairs in SCONE_API_KEYS.
# SCONE_API_KEY alone authorizes the space named default.
SCONE_HOST=127.0.0.1
SCONE_PORT=7437
SCONE_API_KEY=
SCONE_API_KEYS=
SCONE_INGEST_CONCURRENCY=4
SCONE_RELOAD_PAGES=0
SCONE_UI_DEV=0

# Retrieval and evidence logging.
SCONE_CONTEXTUAL_EMBEDDINGS=0
SCONE_DEMOTE_RESTATED=0
# SCONE_SIMILARITY_FLOOR=0.3
# Optional candidate-depth override and trusted operator-provided reranker.
# Empty candidates preserves existing retrieval depth; no provider means off.
# SCONE_RECALL_CANDIDATES=100
SCONE_RERANKER_FACTORY=
# Alternatively select a preprovisioned CPU cross encoder. Both values are
# required, mutually exclusive with SCONE_RERANKER_FACTORY. No model downloads.
SCONE_RERANKER_CROSS_ENCODER_DIR=
SCONE_RERANKER_CROSS_ENCODER_MODEL=
# Optional tuning requires the directory/model pair above.
# SCONE_RERANKER_CROSS_ENCODER_MAX_PAIR_TOKENS=512
# SCONE_RERANKER_CROSS_ENCODER_THREADS=2
# SCONE_RERANKER_CROSS_ENCODER_BATCH_SIZE=8
# Pair tokens 2..8192, threads 1..16, batch size 1..128; install offline-rerank extra.
# SCONE_RERANK_LIMIT=32
# SCONE_RERANK_MAX_BYTES=64000
# SCONE_RERANK_TIMEOUT=1.0
# Bounds: candidates 1..1000, rerank limit 1..128, bytes 512..256000,
# timeout >0..10 seconds. Factory must be a trusted synchronous module:factory
# returning an object with async rerank(query, candidates); no provider default.
SCONE_EVENTS=sqlite
SCONE_EVENTS_QUERIES=hash
SCONE_EVENTS_MAX=10000
# SCONE_EVENTS_MAX_AGE_DAYS=90
# Explicit episode expiry policy; leave empty to retain indefinitely.
SCONE_RETAIN=
# Example only: SCONE_RETAIN='conversation=90,observation=30'
# SCONE_LOG_PATH='~/.scone-memory/runtime.log'

# Existing local model connections: a private JSON file, not provider credentials.
# SCONE_MODEL_CONNECTIONS='~/.scone-memory/model-connections.json'
# SCONE_CONVERSATIONS_JOURNAL='~/.scone-memory/conversations.db'
# Optional trusted Python module:callable; defining a string does not install it.
# SCONE_CONVERSATIONS_MODEL_FACTORY=
# Persona JSON and trusted ProviderRegistry factory must be configured together.
# SCONE_CONVERSATIONS_PERSONAS=
# SCONE_CONVERSATIONS_REGISTRY=

# Opt-in text answer review on the composed conversation server.
# report can retain an uncertain draft; require_supported withholds it.
# Review checks memory-backed turns, not greetings without prepared evidence.
# Endpoint/model are separate from chat/extraction; credentials are never inherited.
SCONE_ANSWER_REVIEW_POLICY=off
# SCONE_ANSWER_REVIEW_URL=http://127.0.0.1:11434/v1
# SCONE_ANSWER_REVIEW_MODEL=YOUR_INSTALLED_MODEL
SCONE_ANSWER_REVIEW_API_KEY=
# SCONE_ANSWER_REVIEW_TIMEOUT=20

# Opt-in adaptive retrieval before text generation; never borrows another key.
# Requires SCONE_CONVERSATIONS_JOURNAL and an explicitly provisioned assessor.
SCONE_ADAPTIVE_RETRIEVAL=0
# SCONE_ADAPTIVE_URL=http://127.0.0.1:11434/v1
# SCONE_ADAPTIVE_MODEL=YOUR_INSTALLED_MODEL
SCONE_ADAPTIVE_API_KEY=
# Whole adaptive retrieval budget; the existing full-turn timeout still applies.
# SCONE_ADAPTIVE_TIMEOUT=15
# SCONE_ADAPTIVE_MAX_ROUNDS=3
# SCONE_ADAPTIVE_MAX_QUERIES=6
# SCONE_ADAPTIVE_CANDIDATE_LIMIT=20
# SCONE_ADAPTIVE_MAX_EVIDENCE_BYTES=16000
# 0 disables pre-assessment graph expansion; 1..6 enables bounded hops.
# SCONE_ADAPTIVE_GRAPH_HOPS=0

# Optional local OpenAI-compatible inference; unset means no default distiller.
# These generic chat/embedding settings can accept public URLs in the base
# engine. Keep them local; no hosted endpoint is supplied here.
SCONE_CHAT_URL=
SCONE_CHAT_MODEL=
SCONE_CHAT_API_KEY=
# SCONE_CHAT_THINK=false
SCONE_CHAT_TIMEOUT=180
SCONE_DISTILL_INTERVAL_S=30
SCONE_DISTILL_BATCH=20
# Unset: proposed for review. Setting a threshold can approve extractions.
# SCONE_DISTILL_ACCEPT_AT=0.95
SCONE_DERIVE=0

# Embedding options: hash, local (cached FastEmbed), remote (your local service).
# Changing the embedder/model for an existing index requires compatible vectors.
# SCONE_EMBED_MODEL=bge-small-en-v1.5
# SCONE_EMBED_URL=http://127.0.0.1:11434/v1
SCONE_EMBED_API_KEY=
# SCONE_EMBED_CACHE='~/.cache/fastembed'

# === Optional self-hosted document/vector/event stores; all inactive ===
# Select with SCONE_DOCUMENTS / SCONE_VECTORS / SCONE_EVENTS only after setup.
# Mongo: document and event store.
# SCONE_MONGO_URL=mongodb://127.0.0.1:27017
# SCONE_MONGO_DB=scone
# PostgreSQL: document/event stores; pgvector required for vector store.
# SCONE_POSTGRES_URL=
# SCONE_POSTGRES_SCHEMA=scone
# Qdrant vector store.
# SCONE_QDRANT_URL=http://127.0.0.1:6333
# SCONE_QDRANT_API_KEY=
# SCONE_QDRANT_COLLECTION=scone_chunks
# Chroma: choose a persistent directory OR a server.
# SCONE_CHROMA_PATH='~/.scone-memory/chroma'
# SCONE_CHROMA_URL=http://127.0.0.1:8000
# LanceDB local vector directory.
# SCONE_LANCEDB_PATH='~/.scone-memory/lancedb'
# Redis requires the search module.
# SCONE_REDIS_URL=redis://127.0.0.1:6379/0
# SCONE_REDIS_PREFIX=scone_chunks
# Milvus Lite file or self-hosted Milvus server.
# SCONE_MILVUS_URI='~/.scone-memory/milvus.db'
# SCONE_MILVUS_TOKEN=
# SCONE_MILVUS_COLLECTION=scone_chunks
# Elasticsearch: document, vector and event stores.
# SCONE_ELASTICSEARCH_URL=http://127.0.0.1:9200
# SCONE_ELASTICSEARCH_API_KEY=
# SCONE_ELASTICSEARCH_PREFIX=scone

# === Python MCP stdio server ===
# Uses the same selected stores. --space is a CLI argument, not an env switch.
# Unset keeps native submitted-fact behavior; a threshold parks low confidence.
# SCONE_MCP_PROPOSE_BELOW=0.9

# === External-agent observation hook (only runs when a host invokes it) ===
# This does not install a Codex/Claude hook or start an agent orchestrator.
SCONE_HOOK_AGENT=codex
SCONE_HOOK_SERVER=http://127.0.0.1:7437
SCONE_HOOK_KEY_ENV=SCONE_API_KEY
SCONE_HOOK_FEED=metadata
SCONE_HOOK_CAPTURE=0
SCONE_HOOK_COMPILE=0
SCONE_HOOK_DEBUG=0
# Empty allowlist makes the direct Python hook send nothing.
SCONE_HOOK_PROJECTS=
# Comma-separated session IDs, only when intentionally restricting capture.
SCONE_HOOK_SESSIONS=
# scripts/observe-agent.cjs uses live-connection.json and injects its own
# SCONE_CAPTURE_KEY, feed and compile flags. Do not duplicate its secret here.

# === Optional framework/library privacy controls (not Scone settings) ===
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
OPENAI_AGENTS_DISABLE_TRACING=true
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ANONYMIZED_TELEMETRY=false

# === Supported Rust cloud-import connectors: deliberately unconfigured ===
# Explicit Rust connector commands contact these services. Do not enable for
# the local-only profile. Tokens are never generated by Scone.
# SCONE_NOTION_TOKEN=
# SCONE_GITHUB_TOKEN=
# SCONE_SLACK_TOKEN=
# SCONE_GOOGLE_DRIVE_TOKEN=

# === Constructor/config-file features, not fixed environment variables ===
# Local STT, TTS and vision are selected in the model-connections JSON/UI.
# Optional API tokens use the exact variable name chosen in api_key_env there.
# Cartesia/ElevenLabs/OpenAI transcription adapters require explicit Python
# provider factories. There is no automatic provider selection from this file.
# Rust CLI settings use its TOML/arguments; api_key_env can name a chosen secret.
# LangChain/LlamaIndex/OpenAI Agents adapters use explicit Python composition.

# === Not implemented as environment switches; no invented credentials ===
# Agent orchestration, external MCP-client discovery, connector scheduling and
# graph-agent execution are not enabled by this file. Pinecone is not connected.
