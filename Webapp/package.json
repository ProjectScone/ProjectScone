{
  "name": "@scone/console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "check:assets": "node scripts/package.mjs --check",
    "test": "node --test tests/*.test.mjs tests/*.test.ts"
  },
  "dependencies": { "react": "19.2.8", "react-dom": "19.2.8", "react-router-dom": "7.18.3" },
  "devDependencies": { "vite": "8.2.2", "@vitejs/plugin-react": "6.1.1", "typescript": "7.0.2", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0" }
}
